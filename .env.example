# Environment Configuration for PeerDrop

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peerdrop?schema=public"

# JWT Secret
JWT_SECRET=super-secret-peerdrop-jwt-key-change-in-production-2026

# WebRTC Config (Optional custom STUN/TURN servers)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
